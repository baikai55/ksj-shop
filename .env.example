# ===== 卡世界配置（本地 .env / Vercel Environment Variables / CF Pages 环境变量）=====

# 官方开放接口
KSJ_BASE_URL=https://ym.ksjhaoka.com/api/index

# 你的店铺 ID（必填，正式环境）
# 后台左下角「复制店铺id」，格式类似 s137OBaD1
# 注意：分享链接 ?token=xxx 不是 store_id
KSJ_STORE_ID=

# 查单含佣金时需要（可选）。后台左下角复制 apikey，每次复制会重置
KSJ_API_KEY=

# 图片 CDN
KSJ_CDN_BASE=https://cdn.ksjhaoka.com/

# 本站
PORT=3000
SITE_NAME=号卡优选

# 仅本地联调：未配置 KSJ_STORE_ID 时是否用演示店铺
ALLOW_DEMO_STORE=false
DEMO_STORE_ID=s137OBaD1
